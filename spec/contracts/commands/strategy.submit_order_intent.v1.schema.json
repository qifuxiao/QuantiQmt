{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:command:strategy.submit_order_intent:v1",
  "title": "SubmitOrderIntentPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_id", "strategy_id", "strategy_version", "account_id", "instrument_id", "side", "position_effect", "order_type", "quantity", "time_in_force", "signal_time", "market_data_version", "valid_until"],
  "properties": {
    "intent_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "strategy_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "strategy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "instrument_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "side": {"enum": ["BUY", "SELL"]},
    "position_effect": {"enum": ["OPEN", "CLOSE", "AUTO"]},
    "order_type": {"enum": ["LIMIT", "MARKET", "BEST"]},
    "quantity": {"type": "integer", "minimum": 1},
    "limit_price": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "time_in_force": {"enum": ["DAY", "IOC", "FOK"]},
    "signal_time": {"type": "string", "format": "date-time"},
    "market_data_version": {"type": "string", "minLength": 1},
    "decision_id": {"type": ["string", "null"]},
    "valid_until": {"type": "string", "format": "date-time"},
    "tags": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 256}, "maxProperties": 32}
  },
  "allOf": [
    {"if": {"properties": {"order_type": {"const": "LIMIT"}}}, "then": {"required": ["limit_price"]}}
  ]
}
