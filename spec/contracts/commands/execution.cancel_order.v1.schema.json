{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:command:execution.cancel_order:v1",
  "title": "ExecutionCancelOrderPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cancel_request_id", "order_id", "client_order_id", "broker", "account_id", "expected_order_version", "fencing_token", "requested_at"],
  "properties": {
    "cancel_request_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "order_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "client_order_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "broker_order_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "broker": {"type": "string", "minLength": 1, "maxLength": 64},
    "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "expected_order_version": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "requested_at": {"type": "string", "format": "date-time"}
  }
}
