{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:internal:ledger-accounting:v1",
  "title": "LedgerAccountingContractV1",
  "oneOf": [
    {"$ref": "#/$defs/ledgerAccount"},
    {"$ref": "#/$defs/tradeAccountingRequest"},
    {"$ref": "#/$defs/ledgerTransaction"},
    {"$ref": "#/$defs/postResult"}
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$",
      "not": {"pattern": "^-0(?:\\.0+)?$"}
    },
    "nonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"
    },
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceTrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broker", "account_id", "trading_day", "trade_id", "order_id", "instrument_id", "side", "position_effect", "price", "quantity", "commission", "tax", "trade_time", "received_at"],
      "properties": {
        "broker": {"type": "string", "minLength": 1, "maxLength": 64},
        "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "trading_day": {"type": "string", "format": "date"},
        "trade_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "order_id": {"$ref": "#/$defs/uuid"},
        "instrument_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "side": {"enum": ["BUY", "SELL"]},
        "position_effect": {"enum": ["OPEN", "CLOSE", "AUTO"]},
        "price": {"$ref": "#/$defs/positiveDecimal"},
        "quantity": {"type": "integer", "minimum": 1},
        "commission": {"$ref": "#/$defs/nonNegativeDecimal"},
        "tax": {"$ref": "#/$defs/nonNegativeDecimal"},
        "trade_time": {"$ref": "#/$defs/timestamp"},
        "received_at": {"$ref": "#/$defs/timestamp"},
        "broker_sequence": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "ledgerAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dto_type", "schema_version", "ledger_account_id", "account_code", "classification", "account_type", "normal_balance", "scope_id", "trading_account_id", "currency", "instrument_id", "active", "created_at"],
      "properties": {
        "dto_type": {"const": "LEDGER_ACCOUNT"},
        "schema_version": {"const": 1},
        "ledger_account_id": {"$ref": "#/$defs/uuid"},
        "account_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.:-]{0,63}$"},
        "classification": {"enum": ["ASSET", "LIABILITY", "EQUITY", "INCOME", "EXPENSE"]},
        "account_type": {"enum": ["CASH", "POSITION_COST", "COMMISSION_EXPENSE", "FEE_EXPENSE", "TAX_EXPENSE", "REALIZED_PNL", "ROUNDING_RESIDUAL", "CAPITAL"]},
        "normal_balance": {"enum": ["DEBIT", "CREDIT"]},
        "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "trading_account_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "currency": {"$ref": "#/$defs/currency"},
        "instrument_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "active": {"type": "boolean"},
        "created_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {"if": {"properties": {"classification": {"enum": ["ASSET", "EXPENSE"]}}, "required": ["classification"]}, "then": {"properties": {"normal_balance": {"const": "DEBIT"}}}},
        {"if": {"properties": {"classification": {"enum": ["LIABILITY", "EQUITY", "INCOME"]}}, "required": ["classification"]}, "then": {"properties": {"normal_balance": {"const": "CREDIT"}}}},
        {"if": {"properties": {"account_type": {"const": "POSITION_COST"}}, "required": ["account_type"]}, "then": {"properties": {"classification": {"const": "ASSET"}, "instrument_id": {"type": "string"}}}, "else": {"properties": {"instrument_id": {"type": "null"}}}}
      ]
    },
    "ledgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "ledger_account_id", "entry_type", "direction", "amount", "currency", "instrument_id", "occurred_at"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/uuid"},
        "ledger_account_id": {"$ref": "#/$defs/uuid"},
        "entry_type": {"enum": ["CASH", "POSITION_COST", "COMMISSION", "FEE", "TAX", "REALIZED_PNL", "ROUNDING_RESIDUAL", "CAPITAL"]},
        "direction": {"enum": ["DEBIT", "CREDIT"]},
        "amount": {"$ref": "#/$defs/positiveDecimal"},
        "currency": {"$ref": "#/$defs/currency"},
        "instrument_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
        "occurred_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "tradeAccountingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dto_type", "schema_version", "source_trade", "source_fingerprint", "idempotency_key", "scope_id", "currency", "cost_basis_method", "rounding_policy_version", "requested_at"],
      "properties": {
        "dto_type": {"const": "TRADE_ACCOUNTING_REQUEST"},
        "schema_version": {"const": 1},
        "source_trade": {"$ref": "#/$defs/sourceTrade"},
        "source_fingerprint": {"$ref": "#/$defs/hash"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "currency": {"$ref": "#/$defs/currency"},
        "cost_basis_method": {"const": "WEIGHTED_AVERAGE_V1"},
        "rounding_policy_version": {"const": "CURRENCY_MINOR_UNIT_HALF_EVEN_V1"},
        "requested_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "ledgerTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dto_type", "schema_version", "transaction_id", "idempotency_key", "source_trade", "source_fingerprint", "scope_id", "currency", "entries", "ledger_sequence", "previous_transaction_checksum", "transaction_checksum", "correlation_id", "causation_id", "recorded_at", "posted_at"],
      "properties": {
        "dto_type": {"const": "LEDGER_TRANSACTION"},
        "schema_version": {"const": 1},
        "transaction_id": {"$ref": "#/$defs/uuid"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_trade": {"$ref": "#/$defs/sourceTrade"},
        "source_fingerprint": {"$ref": "#/$defs/hash"},
        "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "currency": {"$ref": "#/$defs/currency"},
        "entries": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/ledgerEntry"}},
        "ledger_sequence": {"type": "integer", "minimum": 1},
        "previous_transaction_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "transaction_checksum": {"$ref": "#/$defs/hash"},
        "correlation_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "causation_id": {"type": ["string", "null"], "maxLength": 64},
        "recorded_at": {"$ref": "#/$defs/timestamp"},
        "posted_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "postResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dto_type", "schema_version", "outcome", "transaction_id", "ledger_sequence", "failure_code", "detail", "retryable"],
      "properties": {
        "dto_type": {"const": "POST_RESULT"},
        "schema_version": {"const": 1},
        "outcome": {"enum": ["POSTED", "DUPLICATE", "REJECTED", "UNKNOWN"]},
        "transaction_id": {"anyOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
        "ledger_sequence": {"type": ["integer", "null"], "minimum": 1},
        "failure_code": {"enum": [null, "QQ-COMMON-1003", "QQ-STORAGE-7001", "QQ-STORAGE-7002", "QQ-STORAGE-7005", "QQ-STORAGE-7007", "QQ-STORAGE-7008", "QQ-STORAGE-7009"]},
        "detail": {"type": ["string", "null"], "maxLength": 512},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
