{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:contract:control-plane:v1",
  "title": "ControlPlaneInternalDtosV1",
  "oneOf": [
    {"$ref": "#/$defs/observabilityContext"},
    {"$ref": "#/$defs/alertDefinition"},
    {"$ref": "#/$defs/configCandidate"},
    {"$ref": "#/$defs/configActivationResult"},
    {"$ref": "#/$defs/killSwitchCommand"},
    {"$ref": "#/$defs/killSwitchResult"},
    {"$ref": "#/$defs/leaderLease"},
    {"$ref": "#/$defs/recoveryBarrier"},
    {"$ref": "#/$defs/recoveryBarrierAuthorityFact"},
    {"$ref": "#/$defs/controlEventParentFact"},
    {"$ref": "#/$defs/persistedKillSwitchCommandFact"},
    {"$ref": "#/$defs/persistedKillSwitchResultFact"},
    {"$ref": "#/$defs/persistedConfigActivationResultFact"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["dto_type", "schema_version", "correlation_id", "created_at"],
      "properties": {
        "dto_type": {"type": "string"},
        "schema_version": {"const": 1},
        "correlation_id": {"type": "string", "minLength": 16, "maxLength": 128},
        "created_at": {"$ref": "#/$defs/controlTimestamp"}
      }
    },
    "controlTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,6})?Z$"
    },
    "safeInteger": {"type": "number", "multipleOf": 1, "minimum": -9007199254740991, "maximum": 9007199254740991},
    "checksumValue": {
      "oneOf": [
        {"type": ["null", "boolean", "string"]},
        {"$ref": "#/$defs/safeInteger"},
        {"type": "array", "items": {"$ref": "#/$defs/checksumValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/checksumValue"}}
      ]
    },
    "scopeRule": {
      "if": {"properties": {"scope_type": {"const": "GLOBAL"}}, "required": ["scope_type"]},
      "then": {"properties": {"scope_id": {"type": "null"}}},
      "else": {"properties": {"scope_id": {"type": "string", "minLength": 1, "maxLength": 128}}}
    },
    "killSwitchIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_type", "scope_type", "scope_id", "idempotency_key"],
      "properties": {
        "operation_type": {"const": "KILL_SWITCH_COMMAND"},
        "scope_type": {"enum": ["GLOBAL", "ACCOUNT", "STRATEGY", "INSTRUMENT"]},
        "scope_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
        "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256}
      },
      "allOf": [{"$ref": "#/$defs/scopeRule"}]
    },
    "configActivationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_type", "config_domain", "candidate_version", "idempotency_key"],
      "properties": {
        "operation_type": {"const": "CONFIG_ACTIVATION"},
        "config_domain": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
        "candidate_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256}
      }
    },
    "observabilityContext": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["dto_type", "message_id", "causation_id", "source", "service", "instance", "environment", "error_code", "redaction_policy"], "properties": {
          "dto_type": {"const": "OBSERVABILITY_CONTEXT"},
          "message_id": {"type": "string", "minLength": 16, "maxLength": 128},
          "causation_id": {"type": ["string", "null"], "minLength": 16, "maxLength": 64},
          "source": {"type": "string", "minLength": 1},
          "service": {"type": "string", "minLength": 1},
          "instance": {"type": "string", "minLength": 1},
          "environment": {"enum": ["dev", "test", "staging", "prod"]},
          "error_code": {"type": "string", "pattern": "^QQ-[A-Z]+-[0-9]{4}$"},
          "redaction_policy": {"const": "NO_SECRETS_OR_CREDENTIALS"}
        }}
      ]
    },
    "alertDefinition": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["dto_type", "alert_id", "severity", "trigger", "recovery", "owner", "runbook_uri", "evidence_fields", "label_keys", "dedupe_window_seconds", "silence_allowed"], "properties": {
          "dto_type": {"const": "ALERT_DEFINITION"},
          "alert_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
          "severity": {"enum": ["P0", "P1", "P2"]},
          "trigger": {"$ref": "#/$defs/alertThreshold"},
          "recovery": {"$ref": "#/$defs/alertThreshold"},
          "owner": {"type": "string", "minLength": 1},
          "runbook_uri": {"type": "string", "pattern": "^runbook://[^\\s]+$"},
          "evidence_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "label_keys": {"type": "array", "uniqueItems": true, "items": {"enum": ["severity", "component", "alert_code", "environment", "policy_version"]}},
          "dedupe_window_seconds": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "silence_allowed": {"type": "boolean"}
        }}
      ]
    },
    "alertThreshold": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "threshold", "window_seconds", "threshold_version"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "threshold": {"type": "string", "minLength": 1},
        "window_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "threshold_version": {"type": "string", "minLength": 1}
      }
    },
    "limitMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"}},
    "hardLimitPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["valuation_currency", "limits"],
      "properties": {"valuation_currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "limits": {"$ref": "#/$defs/limitMap"}}
    },
    "configComponentAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "generation", "capability_version", "activation_mode", "safe_boundary"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "capability_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "activation_mode": {"enum": ["HOT_RELOAD", "RESTART_REQUIRED"]},
        "safe_boundary": {"enum": ["NEXT_ORDER_BOUNDARY", "NEXT_BAR_BOUNDARY", "RESTART_ONLY"]}
      }
    },
    "componentAck": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "candidate_version", "candidate_checksum", "generation", "capability_version", "prepare_result", "activation_mode", "safe_boundary", "observed_at", "ack_sequence"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "candidate_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "candidate_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "capability_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "prepare_result": {"enum": ["PREPARED", "APPLIED", "REJECTED", "TIMED_OUT"]},
        "activation_mode": {"enum": ["HOT_RELOAD", "RESTART_REQUIRED"]},
        "safe_boundary": {"enum": ["NEXT_ORDER_BOUNDARY", "NEXT_BAR_BOUNDARY", "RESTART_ONLY"]},
        "observed_at": {"$ref": "#/$defs/controlTimestamp"},
        "ack_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "configCandidate": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["dto_type", "config_domain", "candidate_version", "candidate_checksum", "payload", "secret_references", "required_components", "activation_mode", "safe_boundary", "system_hard_limit_policy_version", "system_hard_limit_policy_checksum", "valuation_currency", "dynamic_limits", "system_hard_limit_policy", "component_authority", "policy_version", "policy_checksum", "deadline_at", "idempotency_key"], "properties": {
          "dto_type": {"const": "CONFIG_CANDIDATE"},
          "config_domain": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
          "candidate_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "candidate_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "payload": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/checksumValue"}},
          "secret_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^secret://[^\\s]+$"}},
          "required_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "activation_mode": {"enum": ["HOT_RELOAD", "RESTART_REQUIRED"]},
          "safe_boundary": {"enum": ["NEXT_ORDER_BOUNDARY", "NEXT_BAR_BOUNDARY", "RESTART_ONLY"]},
          "system_hard_limit_policy_version": {"type": "string", "minLength": 1},
          "system_hard_limit_policy_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "valuation_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "dynamic_limits": {"$ref": "#/$defs/limitMap"},
          "system_hard_limit_policy": {"$ref": "#/$defs/hardLimitPolicy"},
          "component_authority": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/configComponentAuthority"}},
          "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "policy_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "deadline_at": {"$ref": "#/$defs/controlTimestamp"},
          "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256}
        }}
      ]
    },
    "configActivationResult": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["dto_type", "result_id", "result_fingerprint", "idempotency_key", "config_domain", "candidate_version", "candidate_checksum", "required_components", "outcome", "component_acks", "previous_active_version", "previous_active_checksum", "active_version", "active_checksum", "rollback_version", "rollback_checksum", "rollback_authority_id", "rollback_authority_checksum", "commit_state", "side_effect_state", "reconciliation_required"], "properties": {
          "dto_type": {"const": "CONFIG_ACTIVATION_RESULT"},
          "result_id": {"type": "string", "minLength": 16, "maxLength": 256},
          "result_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256},
          "config_domain": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"},
          "candidate_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "candidate_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "required_components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "outcome": {"enum": ["APPLIED", "REJECTED", "PARTIAL", "ROLLED_BACK", "UNKNOWN"]},
          "component_acks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/componentAck"}},
          "previous_active_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
          "previous_active_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "active_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
          "active_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "rollback_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
          "rollback_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "rollback_authority_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
          "rollback_authority_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "commit_state": {"enum": ["COMMITTED", "NOT_COMMITTED", "UNKNOWN"]},
          "side_effect_state": {"enum": ["NONE", "COMPLETE", "PARTIAL", "UNKNOWN"]},
          "reconciliation_required": {"type": "boolean"}
        }},
        {"oneOf": [
          {"properties": {"outcome": {"const": "APPLIED"}, "active_version": {"type": "string"}, "active_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rollback_version": {"type": "null"}, "rollback_checksum": {"type": "null"}, "rollback_authority_id": {"type": "null"}, "rollback_authority_checksum": {"type": "null"}, "commit_state": {"const": "COMMITTED"}, "side_effect_state": {"const": "COMPLETE"}, "reconciliation_required": {"const": false}, "component_acks": {"minProperties": 1}}},
          {"properties": {"outcome": {"const": "REJECTED"}, "active_version": {"type": "null"}, "active_checksum": {"type": "null"}, "rollback_version": {"type": "null"}, "rollback_checksum": {"type": "null"}, "rollback_authority_id": {"type": "null"}, "rollback_authority_checksum": {"type": "null"}, "commit_state": {"const": "NOT_COMMITTED"}, "side_effect_state": {"const": "NONE"}, "reconciliation_required": {"const": false}}},
          {"properties": {"outcome": {"const": "PARTIAL"}, "active_version": {"type": "null"}, "active_checksum": {"type": "null"}, "rollback_version": {"type": "null"}, "rollback_checksum": {"type": "null"}, "rollback_authority_id": {"type": "null"}, "rollback_authority_checksum": {"type": "null"}, "commit_state": {"const": "NOT_COMMITTED"}, "side_effect_state": {"const": "PARTIAL"}, "reconciliation_required": {"const": true}, "component_acks": {"minProperties": 1}}},
          {"properties": {"outcome": {"const": "ROLLED_BACK"}, "active_version": {"type": "string"}, "active_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rollback_version": {"type": "string"}, "rollback_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rollback_authority_id": {"type": "string"}, "rollback_authority_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "commit_state": {"const": "COMMITTED"}, "side_effect_state": {"const": "COMPLETE"}, "reconciliation_required": {"const": false}, "component_acks": {"minProperties": 1}}},
          {"properties": {"outcome": {"const": "UNKNOWN"}, "active_version": {"type": "null"}, "active_checksum": {"type": "null"}, "rollback_version": {"type": "null"}, "rollback_checksum": {"type": "null"}, "rollback_authority_id": {"type": "null"}, "rollback_authority_checksum": {"type": "null"}, "commit_state": {"const": "UNKNOWN"}, "side_effect_state": {"const": "UNKNOWN"}, "reconciliation_required": {"const": true}}}
        ]}
      ]
    },
    "authorizationEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_id", "authorization_version", "authorization_checksum", "approver_ids", "approved_at", "valid_until", "revoked"],
      "properties": {
        "authorization_id": {"type": "string", "minLength": 1},
        "authorization_version": {"type": "string", "minLength": 1},
        "authorization_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approver_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "approved_at": {"$ref": "#/$defs/controlTimestamp"},
        "valid_until": {"$ref": "#/$defs/controlTimestamp"},
        "revoked": {"const": false}
      }
    },
    "killSwitchCommand": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["dto_type", "command_id", "command_fingerprint", "scope_type", "scope_id", "desired_state", "cancel_active_orders", "reason", "reason_code", "operator_id", "authorization_evidence", "expected_version", "leader_lease_id", "fencing_token", "deadline_at", "idempotency_key", "recovery_evidence_reference", "recovery_barrier_generation", "recovery_barrier_version", "recovery_barrier_checksum", "recovery_evidence_digest", "recovery_aggregate_evidence_digest", "recovery_policy_version", "recovery_policy_checksum", "recovery_authorization_id", "recovery_authorization_checksum"], "properties": {
          "dto_type": {"const": "KILL_SWITCH_COMMAND"},
          "command_id": {"type": "string", "minLength": 16, "maxLength": 256},
          "command_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "scope_type": {"enum": ["GLOBAL", "ACCOUNT", "STRATEGY", "INSTRUMENT"]},
          "scope_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
          "desired_state": {"enum": ["ON", "OFF"]},
          "cancel_active_orders": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512},
          "reason_code": {"enum": ["MANUAL_EMERGENCY", "RISK_BREACH", "RECOVERY_BARRIER", "CONFIGURATION", "OPERATOR_RELEASE"]},
          "operator_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "approval_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
          "authorization_evidence": {"$ref": "#/$defs/authorizationEvidence"},
          "expected_version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "leader_lease_id": {"type": "string", "minLength": 1},
          "fencing_token": {"type": "string", "minLength": 16, "maxLength": 256},
          "deadline_at": {"$ref": "#/$defs/controlTimestamp"},
          "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256},
          "recovery_evidence_reference": {"type": ["string", "null"], "minLength": 1},
          "recovery_barrier_generation": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
          "recovery_barrier_version": {"type": ["integer", "null"], "minimum": 1, "maximum": 9007199254740991},
          "recovery_barrier_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "recovery_evidence_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "recovery_aggregate_evidence_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "recovery_policy_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 64},
          "recovery_policy_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "recovery_authorization_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
          "recovery_authorization_checksum": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }},
        {"$ref": "#/$defs/scopeRule"},
        {"if": {"properties": {"desired_state": {"const": "ON"}}, "required": ["desired_state"]}, "then": {"properties": {"recovery_evidence_reference": {"type": "null"}, "recovery_barrier_generation": {"type": "null"}, "recovery_barrier_version": {"type": "null"}, "recovery_barrier_checksum": {"type": "null"}, "recovery_evidence_digest": {"type": "null"}, "recovery_aggregate_evidence_digest": {"type": "null"}, "recovery_policy_version": {"type": "null"}, "recovery_policy_checksum": {"type": "null"}, "recovery_authorization_id": {"type": "null"}, "recovery_authorization_checksum": {"type": "null"}}}},
        {"if": {"properties": {"desired_state": {"const": "OFF"}}, "required": ["desired_state"]}, "then": {"properties": {"recovery_evidence_reference": {"type": "string", "minLength": 1}, "recovery_barrier_generation": {"type": "integer", "minimum": 1}, "recovery_barrier_version": {"type": "integer", "minimum": 1}, "recovery_barrier_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recovery_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recovery_aggregate_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recovery_policy_version": {"type": "string", "minLength": 1}, "recovery_policy_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "recovery_authorization_id": {"type": "string", "minLength": 1}, "recovery_authorization_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
      ]
    },
    "effectEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["ack_ids", "observed_at"],
      "properties": {
        "ack_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observed_at": {"$ref": "#/$defs/controlTimestamp"}
      }
    },
    "killSwitchResult": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["dto_type", "result_id", "result_fingerprint", "command_id", "command_fingerprint", "idempotency_key", "scope_type", "scope_id", "expected_version", "desired_state", "effective_state", "outcome", "previous_version", "current_version", "reason_code", "applied_at", "reconciliation_required", "effect_evidence", "authorization_id", "leader_lease_id", "fencing_token", "restores_normal"], "properties": {
          "dto_type": {"const": "KILL_SWITCH_RESULT"},
          "result_id": {"type": "string", "minLength": 16, "maxLength": 256},
          "result_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "command_id": {"type": "string", "minLength": 16, "maxLength": 256},
          "command_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256},
          "scope_type": {"enum": ["GLOBAL", "ACCOUNT", "STRATEGY", "INSTRUMENT"]},
          "scope_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
          "expected_version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "desired_state": {"enum": ["ON", "OFF"]},
          "effective_state": {"enum": ["ON", "OFF", "UNKNOWN"]},
          "outcome": {"enum": ["APPLIED", "REJECTED", "UNKNOWN"]},
          "previous_version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "current_version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "reason_code": {"enum": ["MANUAL_EMERGENCY", "RISK_BREACH", "RECOVERY_BARRIER", "CONFIGURATION", "OPERATOR_RELEASE"]},
          "applied_at": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/controlTimestamp"}]},
          "reconciliation_required": {"type": "boolean"},
          "effect_evidence": {"$ref": "#/$defs/effectEvidence"},
          "authorization_id": {"type": "string", "minLength": 1},
          "leader_lease_id": {"type": "string", "minLength": 1},
          "fencing_token": {"type": "string", "minLength": 16},
          "restores_normal": {"const": false}
        }},
        {"$ref": "#/$defs/scopeRule"},
        {"if": {"properties": {"outcome": {"const": "APPLIED"}, "desired_state": {"const": "ON"}}, "required": ["outcome", "desired_state"]}, "then": {"properties": {"effective_state": {"const": "ON"}, "reconciliation_required": {"const": false}, "applied_at": {"$ref": "#/$defs/controlTimestamp"}, "effect_evidence": {"properties": {"ack_ids": {"minItems": 1}}}}}},
        {"if": {"properties": {"outcome": {"const": "APPLIED"}, "desired_state": {"const": "OFF"}}, "required": ["outcome", "desired_state"]}, "then": {"properties": {"effective_state": {"const": "OFF"}, "reconciliation_required": {"const": false}, "applied_at": {"$ref": "#/$defs/controlTimestamp"}, "effect_evidence": {"properties": {"ack_ids": {"minItems": 1}}}}}},
