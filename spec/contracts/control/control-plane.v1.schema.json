    "recoveryBarrier": {"unevaluatedProperties": false, "allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "required": ["dto_type", "barrier_id", "state", "generation", "opened_at", "evidence", "required_evidence", "invalidation_reason"], "properties": {"dto_type": {"const": "RECOVERY_BARRIER"}, "barrier_id": {"type": "string", "minLength": 1}, "state": {"enum": ["CLOSED", "OPEN", "INVALIDATED"]}, "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "opened_at": {"type": ["string", "null"], "format": "date-time", "pattern": "Z$"}, "evidence": {"type": "object", "additionalProperties": false, "required": ["config_version", "config_checksum", "market_watermark", "audit_watermark", "reconciliation_case_count", "component_versions", "component_checksums"], "properties": {"config_version": {"type": "string", "minLength": 1}, "config_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "market_watermark": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "audit_watermark": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "reconciliation_case_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "component_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}, "component_checksums": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}, "required_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CONFIG_VERIFIED", "MARKET_FRESH", "AUDIT_AVAILABLE", "RECONCILIATION_COMPLETE", "LEASE_FENCED", "OUTBOX_HEALTHY"]}}, "invalidation_reason": {"type": ["string", "null"], "minLength": 1}
