{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:contract:control-validation-context:v1",
  "title": "ControlValidationContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_at", "accepted_policy", "known_messages", "identity_history", "accepted_state"],
  "properties": {
    "evaluation_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "accepted_policy": {"$ref": "#/$defs/policy"},
    "known_messages": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/message"}},
    "identity_history": {"type": "object", "additionalProperties": {"$ref": "#/$defs/identity"}},
    "accepted_state": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "checksum"],
      "properties": {"version": {"type": "string", "minLength": 1}, "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["message_id", "fingerprint", "sequence", "occurred_at", "correlation_id"],
      "properties": {
        "message_id": {"type": "string", "minLength": 16},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "occurred_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "correlation_id": {"type": "string", "minLength": 16}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "decision"],
      "properties": {"fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "decision": {"enum": ["ACCEPTED", "DUPLICATE", "CONFLICT"]}}
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["config", "market", "audit", "lease", "components", "reconciliation", "critical_lag", "kill_switch"],
      "properties": {
        "config": {"$ref": "#/$defs/versioned"},
        "market": {"type": "object", "additionalProperties": false, "required": ["calendar_version", "policy_version", "tzdb_version", "watermark", "unresolved_gap_count", "quality"], "properties": {"calendar_version": {"type": "string"}, "policy_version": {"type": "string"}, "tzdb_version": {"type": "string"}, "watermark": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "unresolved_gap_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "quality": {"enum": ["NORMAL", "DEGRADED", "STALE", "GAP", "UNAVAILABLE"]}}},
        "audit": {"type": "object", "additionalProperties": false, "required": ["outbox_position", "inbox_position", "lag", "healthy"], "properties": {"outbox_position": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "inbox_position": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "lag": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "healthy": {"type": "boolean"}}},
        "lease": {"type": "object", "additionalProperties": false, "required": ["lease_id", "epoch", "fencing_token", "expires_at"], "properties": {"lease_id": {"type": "string"}, "epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "fencing_token": {"type": "string"}, "expires_at": {"type": "string", "format": "date-time", "pattern": "Z$"}}},
        "components": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/component"}},
        "reconciliation": {"type": "object", "additionalProperties": false, "required": ["version", "checksum", "open_blocking_case_count"], "properties": {"version": {"type": "string"}, "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "open_blocking_case_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}},
        "critical_lag": {"type": "object", "additionalProperties": false, "required": ["policy_version", "threshold", "window_seconds", "current", "recovery_window_seconds"], "properties": {"policy_version": {"type": "string"}, "threshold": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "window_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "current": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "recovery_window_seconds": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}},
        "kill_switch": {"type": "object", "additionalProperties": false, "required": ["current_version", "effective_state"], "properties": {"current_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "effective_state": {"enum": ["ON", "OFF", "UNKNOWN"]}}}
      }
    },
    "versioned": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "checksum"],
      "properties": {"version": {"type": "string"}, "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "version", "checksum", "health"],
      "properties": {"generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "version": {"type": "string"}, "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "health": {"enum": ["HEALTHY", "DEGRADED", "UNAVAILABLE", "RECOVERING"]}}
    }
  }
}
