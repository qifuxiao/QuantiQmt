{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:internal:reconciliation:v1",
  "title": "ReconciliationContractV1",
  "oneOf": [
    {"$ref": "#/$defs/reconciliationCase"},
    {"$ref": "#/$defs/caseTransition"},
    {"$ref": "#/$defs/repairCommand"},
    {"$ref": "#/$defs/repairResult"}
  ],
  "$defs": {
    "uuid": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$", "not": {"pattern": "^-0(?:\\.0+)?$"}},
    "caseKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["broker", "account_id", "trading_day", "scope_id", "reason_code"],
      "properties": {
        "broker": {"type": "string", "minLength": 1, "maxLength": 64},
        "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "trading_day": {"type": "string", "format": "date"},
        "scope_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason_code": {"enum": ["CASH_MISMATCH", "POSITION_QUANTITY_MISMATCH", "POSITION_COST_MISMATCH", "TRADE_MISSING_INTERNAL", "TRADE_MISSING_BROKER", "LEDGER_BALANCE_INVALID", "SNAPSHOT_INVALID", "REPAIR_OUTCOME_UNKNOWN"]}
      }
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "currency", "instrument_id"],
      "properties": {
        "kind": {"enum": ["MONEY", "QUANTITY", "DECIMAL", "IDENTITY", "CHECKSUM"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 256},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "instrument_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "internal_value", "broker_value", "delta"],
      "properties": {
        "field": {"enum": ["CASH", "POSITION_QUANTITY", "POSITION_COST", "TRADE_IDENTITY", "CHECKSUM"]},
        "internal_value": {"$ref": "#/$defs/value"},
        "broker_value": {"$ref": "#/$defs/value"},
        "delta": {"$ref": "#/$defs/value"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "case_version", "internal_snapshot_id", "internal_checksum", "internal_checkpoint", "broker_snapshot_id", "broker_observed_at", "broker_sequence", "captured_at", "expires_at"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/uuid"},
        "case_version": {"type": "integer", "minimum": 1},
        "internal_snapshot_id": {"$ref": "#/$defs/uuid"},
        "internal_checksum": {"$ref": "#/$defs/hash"},
        "internal_checkpoint": {"type": "integer", "minimum": 0},
        "broker_snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "broker_observed_at": {"$ref": "#/$defs/timestamp"},
        "broker_sequence": {"type": ["integer", "null"], "minimum": 0},
        "captured_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "created_at", "correlation_id", "causation_id", "last_transition_id", "updated_at"],
      "properties": {
        "created_by": {"type": "string", "minLength": 1, "maxLength": 128},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "correlation_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "causation_id": {"type": ["string", "null"], "maxLength": 64},
        "last_transition_id": {"$ref": "#/$defs/uuid"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "reconciliationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dto_type", "schema_version", "case_id", "case_key", "case_version", "state", "severity", "differences", "evidence", "owner", "deadline_at", "approval_required", "audit"],
      "properties": {
        "dto_type": {"const": "RECONCILIATION_CASE"},
        "schema_version": {"const": 1},
        "case_id": {"$ref": "#/$defs/uuid"},
        "case_key": {"$ref": "#/$defs/caseKey"},
        "case_version": {"type": "integer", "minimum": 1},
        "state": {"enum": ["OPEN", "INVESTIGATING", "PROPOSED", "APPROVED", "REJECTED", "APPLYING", "UNKNOWN", "RESOLVED", "FAILED"]},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "differences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/difference"}},
        "evidence": {"$ref": "#/$defs/evidence"},
        "owner": {"type": ["string", "null"], "maxLength": 128},
        "deadline_at": {"$ref": "#/$defs/timestamp"},
        "approval_required": {"type": "boolean"},
        "audit": {"$ref": "#/$defs/audit"}
      }
    },
    "caseTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dto_type", "schema_version", "transition_id", "case_id", "expected_case_version", "from_state", "to_state", "event", "actor_id", "reason_code", "evidence_id", "occurred_at"],
      "properties": {
        "dto_type": {"const": "CASE_TRANSITION"},
        "schema_version": {"const": 1},
        "transition_id": {"$ref": "#/$defs/uuid"},
        "case_id": {"$ref": "#/$defs/uuid"},
        "expected_case_version": {"type": "integer", "minimum": 1},
        "from_state": {"enum": ["OPEN", "INVESTIGATING", "PROPOSED", "APPROVED", "REJECTED", "APPLYING", "UNKNOWN", "RESOLVED", "FAILED"]},
        "to_state": {"enum": ["OPEN", "INVESTIGATING", "PROPOSED", "APPROVED", "REJECTED", "APPLYING", "UNKNOWN", "RESOLVED", "FAILED"]},
        "event": {"enum": ["Assign", "ProposeRepair", "Approve", "Reject", "Apply", "ApplyUncertain", "VerifyResolved", "ApplyFailed", "ReconcileOutcome", "Reinvestigate"]},
        "actor_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
        "evidence_id": {"$ref": "#/$defs/uuid"},
        "occurred_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "role", "authorized", "policy_version", "fencing_token", "authorized_at"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "role": {"enum": ["RECONCILIATION_AUTOMATION", "OPERATIONS_APPROVER", "EMERGENCY_APPROVER"]},
        "authorized": {"type": "boolean"},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "fencing_token": {"type": "integer", "minimum": 1},
        "authorized_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "approver_id", "decision", "policy_version", "approved_case_version", "approved_evidence_id", "approved_at"],
      "properties": {
        "approval_id": {"$ref": "#/$defs/uuid"},
        "approver_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "decision": {"const": "APPROVE"},
        "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "approved_case_version": {"type": "integer", "minimum": 1},
        "approved_evidence_id": {"$ref": "#/$defs/uuid"},
        "approved_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "repairEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_account_id", "direction", "amount", "currency", "instrument_id"],
      "properties": {
        "ledger_account_id": {"$ref": "#/$defs/uuid"},
        "direction": {"enum": ["DEBIT", "CREDIT"]},
        "amount": {"type": "string", "pattern": "^(?=.*[1-9])(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "instrument_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}
      }
    },
    "repairPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "fact_type", "reason_code", "entries"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/uuid"},
        "fact_type": {"enum": ["LEDGER_ADJUSTMENT", "COMPENSATING_FACT"]},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
        "entries": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/repairEntry"}}
      }
    },
    "repairAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "operation", "target", "payload", "expected_source_version"],
      "properties": {
        "action_id": {"$ref": "#/$defs/uuid"},
        "operation": {"enum": ["APPEND_ADJUSTMENT", "APPEND_COMPENSATING_FACT"]},
        "target": {"enum": ["LEDGER", "PORTFOLIO_PROJECTION"]},
        "payload": {"$ref": "#/$defs/repairPayload"},
        "expected_source_version": {"type": "integer", "minimum": 0}
      }
    },
    "repairCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dto_type", "schema_version", "command_id", "idempotency_key", "case_id", "case_key", "expected_case_version", "expected_portfolio_version", "fencing_token", "mode", "evidence", "authorization", "approval", "actions", "deadline_at", "requested_at"],
      "properties": {
        "dto_type": {"const": "REPAIR_COMMAND"},
        "schema_version": {"const": 1},
        "command_id": {"$ref": "#/$defs/uuid"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
        "case_id": {"$ref": "#/$defs/uuid"},
        "case_key": {"$ref": "#/$defs/caseKey"},
        "expected_case_version": {"type": "integer", "minimum": 1},
        "expected_portfolio_version": {"type": "integer", "minimum": 0},
        "fencing_token": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["AUTOMATIC", "MANUAL"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "authorization": {"$ref": "#/$defs/authorization"},
        "approval": {"anyOf": [{"$ref": "#/$defs/approval"}, {"type": "null"}]},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repairAction"}},
        "deadline_at": {"$ref": "#/$defs/timestamp"},
        "requested_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "repairResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dto_type", "schema_version", "command_id", "case_id", "outcome", "case_version", "appended_fact_ids", "failure_code", "reconciliation_required", "audit_id", "completed_at"],
      "properties": {
        "dto_type": {"const": "REPAIR_RESULT"},
        "schema_version": {"const": 1},
        "command_id": {"$ref": "#/$defs/uuid"},
        "case_id": {"$ref": "#/$defs/uuid"},
        "outcome": {"enum": ["APPLIED", "DUPLICATE", "REJECTED", "UNKNOWN"]},
        "case_version": {"type": "integer", "minimum": 1},
        "appended_fact_ids": {"type": "array", "items": {"$ref": "#/$defs/uuid"}, "uniqueItems": true},
        "failure_code": {"enum": [null, "QQ-COMMON-1003", "QQ-STORAGE-7001", "QQ-RECOVERY-8004", "QQ-RECOVERY-8005", "QQ-RECOVERY-8006", "QQ-RECOVERY-8007"]},
        "reconciliation_required": {"type": "boolean"},
        "audit_id": {"$ref": "#/$defs/uuid"},
        "completed_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
