{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:contract:message-envelope:v1",
  "title": "MessageEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "message_type", "schema_version", "occurred_at", "received_at", "correlation_id", "source", "partition_key", "payload"],
  "properties": {
    "message_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "message_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.v[1-9][0-9]*$"},
    "schema_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "causation_id": {"type": ["string", "null"], "minLength": 16, "maxLength": 64},
    "aggregate_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "aggregate_version": {"type": ["integer", "null"], "minimum": 1},
    "source": {"type": "string", "minLength": 1, "maxLength": 128},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 128},
    "partition_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "aggregate_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "payload_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idempotency_key": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "payload": {"type": "object"}
  }
}
