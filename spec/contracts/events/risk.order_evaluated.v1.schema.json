{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:event:risk.order_evaluated:v1",
  "title": "RiskOrderEvaluatedPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "order_id", "expected_order_version", "decision", "rule_set_version", "snapshot_versions", "rule_results", "evaluated_at"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "order_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "expected_order_version": {"type": "integer", "minimum": 1},
    "decision": {"enum": ["PASS", "REJECT"]},
    "rule_set_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "snapshot_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["account", "portfolio", "market"],
      "properties": {"account": {"type": "string", "minLength": 1, "maxLength": 128}, "portfolio": {"type": "string", "minLength": 1, "maxLength": 128}, "market": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "rule_results": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["rule_id", "result", "reason_code", "latency_us"], "properties": {"rule_id": {"type": "string", "minLength": 1, "maxLength": 128}, "result": {"enum": ["PASS", "REJECT", "NOT_APPLICABLE"]}, "reason_code": {"type": "string", "minLength": 1, "maxLength": 128}, "measured_value": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"}, "limit_value": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"}, "latency_us": {"type": "integer", "minimum": 0}}}
    },
    "evaluated_at": {"type": "string", "format": "date-time"}
  }
}
