{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:event:config.version_activated:v1",
  "title": "ConfigVersionActivatedPayloadV1",
  "$comment": "Occurred ActiveVersion authority change only; component prepare/apply/rollback effects and convergence are internal ConfigActivationResult facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_domain",
    "activation_kind",
    "trigger_candidate_version",
    "trigger_candidate_checksum",
    "previous_version",
    "previous_checksum",
    "active_version",
    "active_checksum",
    "activation_mode",
    "safe_boundary",
    "required_components",
    "secret_references",
    "policy_version",
    "policy_checksum",
    "rollback_cause_result_id",
    "activated_at",
    "activation_sequence"
  ],
  "properties": {
    "config_domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
    },
    "activation_kind": {
      "enum": [
        "CANDIDATE_COMMIT",
        "ROLLBACK_RESTORE"
      ]
    },
    "trigger_candidate_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "trigger_candidate_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "previous_checksum": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "active_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "active_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activation_mode": {
      "enum": [
        "HOT_RELOAD",
        "RESTART_REQUIRED"
      ]
    },
    "safe_boundary": {
      "enum": [
        "NEXT_ORDER_BOUNDARY",
        "NEXT_BAR_BOUNDARY",
        "RESTART_ONLY"
      ]
    },
    "required_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "secret_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^secret://[^\\s]+$"
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "policy_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollback_cause_result_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 16,
      "maxLength": 256
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,6})?Z$"
    },
    "activation_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "activation_mode": {
            "const": "RESTART_REQUIRED"
          }
        },
        "required": [
          "activation_mode"
        ]
      },
      "then": {
        "properties": {
          "safe_boundary": {
            "const": "RESTART_ONLY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "previous_version": {
            "type": "null"
          }
        },
        "required": [
          "previous_version"
        ]
      },
      "then": {
        "properties": {
          "previous_checksum": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_checksum": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activation_kind": {
            "const": "CANDIDATE_COMMIT"
          }
        },
        "required": [
          "activation_kind"
        ]
      },
      "then": {
        "properties": {
          "rollback_cause_result_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_version": {
            "type": "string"
          },
          "previous_checksum": {
            "type": "string"
          },
          "rollback_cause_result_id": {
            "type": "string"
          }
        }
      }
    }
  ]
}
