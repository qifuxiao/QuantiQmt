{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:event:config.version_activated:v1",
  "title": "ConfigVersionActivatedPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_domain",
    "candidate_version",
    "candidate_checksum",
    "previous_version",
    "active_version",
    "active_checksum",
    "activation_mode",
    "safe_boundary",
    "required_components",
    "component_acks",
    "secret_references",
    "policy_version",
    "policy_checksum",
    "activated_at",
    "activation_sequence"
  ],
  "properties": {
    "config_domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
    },
    "candidate_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "candidate_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_version": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64
    },
    "active_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "active_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activation_mode": {
      "enum": [
        "HOT_RELOAD",
        "RESTART_REQUIRED"
      ]
    },
    "safe_boundary": {
      "enum": [
        "NEXT_ORDER_BOUNDARY",
        "NEXT_BAR_BOUNDARY",
        "RESTART_ONLY"
      ]
    },
    "required_components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "component_acks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "candidate_version",
          "candidate_checksum",
          "generation",
          "capability_version",
          "result",
          "activation_mode",
          "safe_boundary",
          "observed_at",
          "ack_sequence"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "candidate_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "candidate_checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "capability_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "result": {
            "const": "APPLIED"
          },
          "activation_mode": {
            "enum": [
              "HOT_RELOAD",
              "RESTART_REQUIRED"
            ]
          },
          "safe_boundary": {
            "enum": [
              "NEXT_ORDER_BOUNDARY",
              "NEXT_BAR_BOUNDARY",
              "RESTART_ONLY"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,6})?Z$"
          },
          "ack_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    "secret_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^secret://[^\\s]+$"
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "policy_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,6})?Z$"
    },
    "activation_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "activation_mode": {
            "const": "RESTART_REQUIRED"
          }
        },
        "required": [
          "activation_mode"
        ]
      },
      "then": {
        "properties": {
          "safe_boundary": {
            "const": "RESTART_ONLY"
          }
        }
      }
    }
  ]
}
