{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:event:execution.attempt_started:v1",
  "title": "ExecutionAttemptStartedPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_id", "order_id", "operation", "client_order_id", "broker", "account_id", "expected_order_version", "fencing_token", "started_at"],
  "properties": {
    "attempt_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "order_id": {"type": "string", "minLength": 16, "maxLength": 64},
    "operation": {"enum": ["SUBMIT", "CANCEL"]},
    "client_order_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "cancel_request_id": {"type": ["string", "null"], "minLength": 16, "maxLength": 64},
    "broker": {"type": "string", "minLength": 1, "maxLength": 64},
    "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "expected_order_version": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [{"if": {"properties": {"operation": {"const": "CANCEL"}}}, "then": {"required": ["cancel_request_id"], "properties": {"cancel_request_id": {"type": "string", "minLength": 16, "maxLength": 64}}}}]
}
