{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:event:system.kill_switch_changed:v1",
  "title": "SystemKillSwitchChangedPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "command_id", "command_fingerprint", "scope", "desired_state", "effective_state", "reason_code", "actor", "authorization_evidence", "expected_version", "previous_version", "current_version", "leader_lease_id", "leader_id", "lease_epoch", "fencing_token", "deadline_at", "idempotency_key", "reserved_capacity", "recovery_evidence_reference", "outcome", "reconciliation_required", "restores_normal", "effect_evidence", "policy_version", "policy_checksum", "occurred_at", "correlation_id", "source"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "command_id": {"type": "string", "minLength": 16, "maxLength": 256},
    "command_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"enum": ["GLOBAL", "ACCOUNT", "STRATEGY", "INSTRUMENT"]},
    "desired_state": {"enum": ["ON", "OFF"]},
    "effective_state": {"enum": ["ON", "OFF", "UNKNOWN"]},
    "reason_code": {"enum": ["MANUAL_EMERGENCY", "RISK_BREACH", "RECOVERY_BARRIER", "CONFIGURATION", "OPERATOR_RELEASE"]},
    "actor": {"type": "string", "minLength": 1, "maxLength": 128},
    "authorization_evidence": {"type": "object", "additionalProperties": false, "required": ["authorization_id", "authorization_version", "authorization_checksum", "approver_ids", "approved_at", "valid_until", "revoked"], "properties": {"authorization_id": {"type": "string", "minLength": 1}, "authorization_version": {"type": "string", "minLength": 1}, "authorization_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "approver_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "approved_at": {"type": "string", "format": "date-time", "pattern": "Z$"}, "valid_until": {"type": "string", "format": "date-time", "pattern": "Z$"}, "revoked": {"const": false}}},
    "expected_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previous_version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "current_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "leader_lease_id": {"type": "string", "minLength": 1},
    "leader_id": {"type": "string", "minLength": 1},
    "lease_epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "fencing_token": {"type": "string", "minLength": 16},
    "deadline_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 256},
    "reserved_capacity": {"type": "object", "additionalProperties": false, "required": ["cancel", "recovery"], "properties": {"cancel": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "recovery": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}},
    "recovery_evidence_reference": {"type": ["string", "null"], "minLength": 1},
    "effect_evidence": {"type": "object", "additionalProperties": false, "required": ["ack_ids", "observed_at"], "properties": {"ack_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"}}},
    "outcome": {"enum": ["APPLIED", "REJECTED", "PARTIAL", "TIMEOUT", "UNKNOWN"]},
    "reconciliation_required": {"type": "boolean"},
    "restores_normal": {"type": "boolean"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "policy_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "correlation_id": {"type": "string", "minLength": 16, "maxLength": 128},
    "source": {"type": "string", "const": "ControlPlane"}
  },
  "allOf": [
    {"if": {"properties": {"desired_state": {"const": "ON"}}}, "then": {"properties": {"effective_state": {"enum": ["ON", "UNKNOWN"]}, "outcome": {"enum": ["APPLIED", "TIMEOUT", "UNKNOWN"]}}}},
    {"if": {"properties": {"outcome": {"const": "APPLIED"}}}, "then": {"properties": {"effective_state": {"enum": ["ON", "OFF"]}}}}
  ]
}
