{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:event:system.component_health_changed:v1",
  "title": "SystemComponentHealthChangedPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "component", "component_version", "generation", "previous_health", "health", "reason_code", "observed_at", "correlation_id", "source", "evidence"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "component": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "component_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "previous_health": {"enum": ["HEALTHY", "DEGRADED", "UNAVAILABLE", "RECOVERING"]},
    "health": {"enum": ["HEALTHY", "DEGRADED", "UNAVAILABLE", "RECOVERING"]},
    "reason_code": {"enum": ["PROBE_PASSED", "PROBE_FAILED", "DEPENDENCY_STALE", "DISCONNECTED", "RECOVERY_STARTED", "RECOVERY_VERIFIED", "CAPACITY_EXHAUSTED", "AUDIT_UNAVAILABLE"]},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "correlation_id": {"type": "string", "minLength": 16, "maxLength": 128},
    "source": {"type": "string", "const": "HealthService"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["probe_id", "policy_version", "policy_checksum"], "properties": {"probe_id": {"type": "string", "minLength": 1}, "policy_version": {"type": "string", "minLength": 1}, "policy_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
