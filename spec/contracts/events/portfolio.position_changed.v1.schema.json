{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:event:portfolio.position_changed:v1",
  "title": "PortfolioPositionChangedPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["account_id", "instrument_id", "trading_day", "position_version", "source_ledger_transaction_id", "previous_quantity", "current_quantity", "available_quantity", "currency", "changed_at"],
  "properties": {
    "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "instrument_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "trading_day": {"type": "string", "format": "date"},
    "position_version": {"type": "integer", "minimum": 1},
    "source_ledger_transaction_id": {"type": "string", "format": "uuid"},
    "previous_quantity": {"type": "integer"},
    "current_quantity": {"type": "integer"},
    "available_quantity": {"type": "integer", "minimum": 0},
    "average_cost": {"type": ["string", "null"], "pattern": "^(?=.*[1-9])(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"},
    "market_value": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,8})?$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "changed_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
