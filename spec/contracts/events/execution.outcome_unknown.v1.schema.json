{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quantiqmt:event:execution.outcome_unknown:v1",
  "title": "ExecutionOutcomeUnknownPayloadV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_id", "order_id", "operation", "client_order_id", "broker", "account_id", "fencing_token", "reason_code", "reconciliation_required", "unknown_at"],
  "properties": {
    "attempt_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "order_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "operation": {"enum": ["SUBMIT", "CANCEL"]},
    "client_order_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "cancel_request_id": {"type": ["string", "null"], "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "broker": {"type": "string", "minLength": 1, "maxLength": 64},
    "account_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "fencing_token": {"type": "integer", "minimum": 1},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "reconciliation_required": {"const": true},
    "unknown_at": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "allOf": [{"if": {"properties": {"operation": {"const": "CANCEL"}}}, "then": {"required": ["cancel_request_id"], "properties": {"cancel_request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}}}}]
}
