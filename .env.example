QUANTIQMT_ENV=development
QUANTIQMT_LOG_LEVEL=INFO
QUANTIQMT_POSTGRES_DSN=postgresql://quantiqmt:quantiqmt@localhost:5432/quantiqmt_test

# Mini QMT M1 defaults are fail-closed. Fill only a simulation account.
QUANTIQMT_PROFILE=MINIQMT_SIM_READONLY
QUANTIQMT_QMT_USERDATA_PATH=
QUANTIQMT_QMT_ACCOUNT_ID=
QUANTIQMT_QMT_ACCOUNT_TYPE=STOCK
QUANTIQMT_QMT_SESSION_ID=12001
QUANTIQMT_QMT_ALLOWED_ACCOUNT_IDS=
QUANTIQMT_QMT_ORDER_SEND_ENABLED=false
QUANTIQMT_KILL_SWITCH_ENGAGED=true
QUANTIQMT_MAX_ORDER_NOTIONAL_CNY=1000.00
QUANTIQMT_ALLOWED_INSTRUMENTS=

# Log in with the Mini QMT desktop client. Do not add a QMT password here.
# Secrets and real broker credentials must come from a controlled secret provider.
